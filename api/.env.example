# FTCCI API settings. Copy this file to api/.env and fill in the values.
# api/.env is ignored by git: never commit real passwords, keys or mailbox credentials.

# development | production
NODE_ENV=development
# Address and port the API listens on. Keep 127.0.0.1 and put Nginx in front in production.
HOST=127.0.0.1
PORT=8787

# PostgreSQL connection. In development `npm run dev` starts a local database with exactly these details.
DATABASE_URL=postgres://ftcci_dev:change-me@127.0.0.1:5433/ftcci

# Public address of the website, used for links in emails (no trailing slash).
# Development: http://localhost:5173/ftcci   Production: https://www.ftcci.in
PUBLIC_SITE_URL=http://localhost:5173/ftcci

# Address of the staff admin (no trailing slash). Used in sign-in emails, and only pages from this
# address may sign in or make changes. Development: http://127.0.0.1:5174/admin  Production: https://www.ftcci.in/admin
ADMIN_URL=http://127.0.0.1:5174/admin

# Behind Nginx, the proxy's address (127.0.0.1 when Nginx runs on the same server). Leave empty in development.
TRUST_PROXY=

# Outgoing email (SMTP). See docs/email-setup.md.
# Development without a mailbox: SMTP_HOST=127.0.0.1 and SMTP_PORT=1025 catch every email in api/.data/mail.
# Gmail for testing: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=the Gmail address, SMTP_PASS=its app password.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Sender shown on every email. With Gmail this must be the same Gmail address as SMTP_USER.
MAIL_FROM=FTCCI <noreply@example.org>
# Optional: where visitors' replies to confirmation emails go (for example info@ftcci.in).
MAIL_REPLY_TO=

# Who receives each form's notification. Each can point at a different FTCCI desk.
BOOKING_NOTIFY_EMAIL=bookings@example.org
MEMBERSHIP_NOTIFY_EMAIL=membership@example.org
EVENTS_NOTIFY_EMAIL=events@example.org
CONTACT_NOTIFY_EMAIL=info@example.org
NEWSLETTER_NOTIFY_EMAIL=info@example.org

# Signs spam-check challenges (ALTCHA), content preview links and staff sign-in codes. At least 32
# random characters, different on every server. Changing it cancels open previews and sign-in codes:
#   openssl rand -hex 32
ALTCHA_HMAC_SECRET=

# Uploaded images, PDFs and videos. Development defaults to api/.data/media; in production use an
# absolute path outside the app folder (for example /srv/ftcci/media) and let Nginx serve it at MEDIA_URL.
MEDIA_DIR=
MEDIA_URL=/media
# ffmpeg compresses hero videos. `npm run dev` uses a bundled copy; on a server install ffmpeg (apt install ffmpeg).
FFMPEG_PATH=

# Set to false on extra API instances so only one sends emails and processes uploads (optional).
RUN_WORKER=true
